<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Display Screen (Input Box) -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:layout_marginBottom="16dp"
        android:background="@color/bg_display"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/text_display"
        android:textSize="52sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnC" />

    <!-- Row 1 Buttons -->
    <Button
        android:id="@+id/btnC"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="C"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_clear_bg"
        android:textColor="@color/btn_clear_text"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnOpenBracket"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnOpenBracket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="("
        android:textSize="20sp"
        android:backgroundTint="@color/btn_function_bg"
        android:textColor="@color/btn_function_text"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@+id/btnC"
        app:layout_constraintEnd_toStartOf="@+id/btnCloseBracket"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnCloseBracket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text=")"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_function_bg"
        android:textColor="@color/btn_function_text"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@+id/btnOpenBracket"
        app:layout_constraintEnd_toStartOf="@+id/btnDivide"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnDivide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="/"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@+id/btnCloseBracket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <!-- Row 2 Buttons -->
    <Button
        android:id="@+id/btn7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="7"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btnC"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn8"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="8"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btnC"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@+id/btn7"
        app:layout_constraintEnd_toStartOf="@+id/btn9"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="9"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btnC"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@+id/btn8"
        app:layout_constraintEnd_toStartOf="@+id/btnMultiply"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnMultiply"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="×"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:layout_constraintTop_toBottomOf="@id/btnC"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@+id/btn9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <!-- Row 3 Buttons -->
    <Button
        android:id="@+id/btn4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="4"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintBottom_toTopOf="@id/btn1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="5"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintBottom_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@+id/btn4"
        app:layout_constraintEnd_toStartOf="@+id/btn6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="6"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintBottom_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@+id/btn5"
        app:layout_constraintEnd_toStartOf="@+id/btnSubtract"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnSubtract"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="-"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintBottom_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@+id/btn6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <!-- Row 4 Buttons -->
    <Button
        android:id="@+id/btn1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="1"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintBottom_toTopOf="@id/btn00"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="2"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintBottom_toTopOf="@id/btn00"
        app:layout_constraintStart_toEndOf="@+id/btn1"
        app:layout_constraintEnd_toStartOf="@+id/btn3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="3"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintBottom_toTopOf="@id/btn00"
        app:layout_constraintStart_toEndOf="@+id/btn2"
        app:layout_constraintEnd_toStartOf="@+id/btnAdd"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="+"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintBottom_toTopOf="@id/btn00"
        app:layout_constraintStart_toEndOf="@+id/btn3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <!-- Row 5 Buttons -->
    <Button
        android:id="@+id/btn00"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="00"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn0"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btn0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn00"
        app:layout_constraintEnd_toStartOf="@+id/btnDot"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnDot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="."
        android:textSize="20sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn0"
        app:layout_constraintEnd_toStartOf="@+id/btnEquals"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/btnEquals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="="
        android:textSize="20sp"
        android:backgroundTint="@color/btn_equals_bg"
        android:textColor="@color/btn_equals_text"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnDot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>